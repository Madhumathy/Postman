						"exec": [
							"pm.collectionVariables.set(\"firstname\", pm.iterationData.get(\"Firstname\"))\r",
							"pm.globals.set(\"lastname\", pm.iterationData.get(\"Lastname\"))"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
