							"    pm.expect(pm.response.code).to.eql(200)\r",
							"})\r",
							"\r",
							"pm.test('Validating whether the response time is less than 140', function(){\r",
							"    pm.expect(pm.response.responseTime).to.lessThan(1400)\r",
							"})\r",
							"\r",
							"pm.test('Validation of booking Id and firstname', function(){\r",
							"    console.log(pm.response.json().bookingid)\r",
							"    pm.expect(pm.response.json().booking.firstname).to.eql(\"Jim\")\r",
							"})\r",
							"\r",
							"console.log(pm.collectionVariables.get(\"id\"))\r",
							"const id = pm.response.json().bookingid\r",
							"pm.collectionVariables.set(\"id\", id);\r",
							"\r",
							"console.log(pm.globals.get(\"lastname\"))\r",
							"\r",
							"const firstname = pm.response.json().booking.firstname\r",
							"pm.collectionVariables.set('firstname', firstname)\r",
							""
